<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org. Clears any machine-level feeds so a fresh clone restores
       identically everywhere, including CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
